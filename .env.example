# Copy to .env and fill in. NEVER commit .env — this repo is public.

# --- Postgres (matches docker-compose service name `db`) ---
POSTGRES_USER=clinetics
POSTGRES_PASSWORD=clinetics_dev_pw
POSTGRES_DB=clinetics
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Async driver for the FastAPI app
DATABASE_URL=postgresql+asyncpg://clinetics:clinetics_dev_pw@localhost:5432/clinetics
# Sync driver for Alembic migrations (Alembic runs sync by default)
DATABASE_URL_SYNC=postgresql+psycopg://clinetics:clinetics_dev_pw@localhost:5432/clinetics

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- App ---
ENVIRONMENT=local
LOG_LEVEL=INFO
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-your-local-dotenv

# Auth. Tokens are delivered as httpOnly cookies and are never readable by
# JavaScript. The access token is short-lived on purpose: the role is embedded
# in it, so this is the upper bound on how stale a permission check can be.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# MUST be true in production: it stops the browser sending cookies over plain
# HTTP. Left false locally because dev runs without TLS.
COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:3000

# --- LLM (Phase 5) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
AGENT_MODEL_DEFAULT=claude-haiku-4-5-20251001
AGENT_MODEL_COMPLEX=claude-sonnet-5

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
