# --- Data / model artifacts (regenerate, never commit) ---
data/
*.csv
*.parquet
*.pkl
*.joblib
# Model binaries are derived: regenerable from committed code + data with a
# fixed seed, and too large to be useful in review.
backend/artifacts/

# Reports ARE committed. They are the evidence behind the project's claims --
# the Phase 1 validation plots and the Phase 3 metrics -- and a reader should be
# able to check them without running anything.
!backend/reports/
!backend/reports/**/*.png
!backend/reports/**/*.json

